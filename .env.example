# Google Cloud OAuth "Web application" client ID (see README → Google setup)
VITE_GOOGLE_CLIENT_ID=
# Browser API key restricted to your origins (used only by Google Picker for "Import from Drive")
VITE_GOOGLE_API_KEY=
# Google Cloud project number (Picker "appId")
VITE_GOOGLE_APP_ID=
# Where BusyTeX assets are served from (same origin is required for the worker). Default: /core/busytex
VITE_TEX_ASSETS_URL=/core/busytex
# Optional TeX Live on-demand endpoint for packages not in the bundled collections
VITE_TEX_REMOTE_ENDPOINT=
