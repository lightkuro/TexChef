# Google Cloud OAuth "Web application" client ID (see README → Google setup)
VITE_GOOGLE_CLIENT_ID=
# Browser API key restricted to your origins (used only by Google Picker for "Import from Drive")
VITE_GOOGLE_API_KEY=
# Google Cloud project number (Picker "appId")
VITE_GOOGLE_APP_ID=
# Where the BusyTeX engine is served from (must be same origin: it starts a Web Worker). Default: /core/busytex
VITE_TEX_ASSETS_URL=/core/busytex
# Optional TeX Live on-demand endpoint for packages not in the bundled collections
VITE_TEX_REMOTE_ENDPOINT=

# Shown on the Privacy Policy and Terms pages (/privacy, /terms). Set before making the site public.
# Who runs the site, e.g. "Jane Doe" or "Kurolight"
VITE_LEGAL_OPERATOR=
# Contact for privacy/legal questions: an email address or a URL (default: https://kurolight.dev/contact)
VITE_LEGAL_CONTACT=
# Governing law for the Terms, e.g. "the State of Washington, USA"
VITE_LEGAL_JURISDICTION=
