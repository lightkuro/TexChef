{
  "name": "texchef",
  "private": true,
  "version": "0.1.0",
  "description": "Browser LaTeX editor for master resumes and linked, role-focused variants. Local-first, syncs to your own Google Drive.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm build && node scripts/shard-tex-assets.mjs tex-assets/busytex dist/core/busytex",
    "cf:build": "pnpm tex:assets && pnpm build:pages",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "tex:assets": "texlyre-busytex download-assets tex-assets",
    "e2e:engines": "node e2e/engines.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.12.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.69.0",
    "node-diff3": "3.2.1",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.18.1",
    "react-router": "7.18.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "texlyre-busytex": "1.4.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
